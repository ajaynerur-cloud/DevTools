diff -ruN a/styles.css b/styles.css
--- a/styles.css	2026-10-12 18:07:14.482951994 +0000
+++ b/styles.css	2026-10-12 18:07:14.486813175 +0000
@@ -863,3 +863,33 @@
   .tk-board:not(.lay-list) .e-d { display: none; }
   .tk-board:not(.lay-list) .e-m { display: inline; }
 }
+
+.build { font-size: .7rem; color: var(--muted); opacity: .7; padding: 6px 12px 0; font-family: var(--mono); }
+@media (max-width: 800px) { .build { display: none; } }
+/* the page never scrolls sideways; wide content (tables, previews) scrolls inside its own box */
+main { overflow-x: clip; }
+
+/* ================= Compact view on every task tab (toolbar “Compact” button) ================= */
+.tk-densebtn { display: inline-flex; align-items: center; gap: 6px; font-size: .86rem; }
+.tk-densebtn svg { width: 16px; height: 16px; }
+.tk-densebtn[aria-pressed="true"] { color: var(--accent); border-color: var(--accent); background: color-mix(in srgb, var(--accent) 10%, var(--surface)); }
+/* list rows (Week, All): one tight line — title with its details beside it */
+.tk-dense .tk-sec { margin-top: 10px; }
+.tk-dense .tk-sec > header, .tk-dense .tk-sec > summary { padding: 2px 2px 4px; }
+.tk-dense .tk-sec h2 { font-size: .9rem; }
+.tk-dense .tk-row { gap: 10px; padding: 6px 10px 6px 12px; }
+.tk-dense .tk-row::before { top: 6px; bottom: 6px; }
+.tk-dense .tk-check { width: 18px; height: 18px; min-width: 18px; height: 18px; border-width: 2px; }
+.tk-dense .tk-row.done .tk-check::after, .tk-dense .tk-row.completing .tk-check::after { left: 4px; top: 1px; width: 4px; height: 8px; }
+.tk-dense .tk-main { flex-direction: row; flex-wrap: wrap; align-items: baseline; align-content: center; gap: 0 12px; }
+.tk-dense .tk-title { font-size: .9rem; line-height: 1.3; }
+.tk-dense .tk-meta { font-size: .76rem; line-height: 1.3; gap: 0 6px; }
+.tk-dense .mt .ic { width: 12px; height: 12px; }
+.tk-dense .tk-timer { padding: 2px 8px; font-size: .74rem; }
+.tk-dense .tk-empty { padding: 10px 0; }
+@media (max-width: 800px) {
+  .tk-densebtn span { display: none; }
+  .tk-dense .tk-row { padding: 8px 10px 8px 12px; }   /* keep rows easy to tap */
+  .tk-dense .tk-main { flex-direction: row; flex-wrap: wrap; align-items: center; align-content: center; min-height: 38px !important; gap: 0 10px; }
+  .tk-dense .tk-row { padding: 4px 10px 4px 12px; }
+}
